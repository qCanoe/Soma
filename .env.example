# =============================================================================
# MindWave / Soma — environment template
# -----------------------------------------------------------------------------
# 1. Copy this file to `.env` and fill in secrets (`.env` must stay gitignored).
# 2. Node scripts under `scripts/` load `.env` automatically (see api_test.js).
# 3. Python (`music_ai_module`) does NOT read `.env` by itself. Before running
#    Python, either:
#      - export variables in your shell, or
#      - use your IDE’s env-file feature, or
#      - `pip install python-dotenv` and load it in your own entry script.
# =============================================================================

# -----------------------------------------------------------------------------
# Suno API (sunoapi.org → https://api.sunoapi.org)
# -----------------------------------------------------------------------------
# Used by Node scripts: `scripts/api_test.js`, `scripts/generate_cases.js`
# (they accept API_KEY or SUNO_API_KEY).
API_KEY=

# Used by Python `SystemConfig.suno_api_key` when you call Layer 4 from code.
# If you use both Node and Python, set both API_KEY and SUNO_API_KEY to the
# same value, or set only SUNO_API_KEY and use it from Node via SUNO_API_KEY.
SUNO_API_KEY=

# -----------------------------------------------------------------------------
# OpenAI-compatible API (LLM + embeddings for music_ai_module)
# -----------------------------------------------------------------------------
# Required for: optional prompt verify, knowledge ingest --extract, embedding
# retrieval when OPENAI_API_KEY is set (otherwise chunk retrieval falls back to
# keyword overlap).
OPENAI_API_KEY=

# Base URL for chat + embeddings (default: OpenAI). Use a proxy or other
# OpenAI-compatible host by overriding LLM_BASE_URL.
LLM_BASE_URL=https://api.openai.com/v1

# Chat model: verification (`verify=True`) and `knowledge ingest --extract`.
LLM_MODEL=gpt-3.5-turbo

# Embedding model name supported by your LLM_BASE_URL provider.
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Knowledge graph / GraphRAG (optional)
# -----------------------------------------------------------------------------
# Override default `data/knowledge` under the repo (absolute path recommended).
# KNOWLEDGE_DATA_DIR=

# If true, MusicAIPipeline always runs the clinical auditor without passing
# use_knowledge_graph=True (values: 1, true, yes).
# KNOWLEDGE_ENABLED_DEFAULT=

# KNOWLEDGE_MAX_PROMPT_CHARS=500
# KNOWLEDGE_MAX_ANCHOR_CHARS=200
# KNOWLEDGE_CHUNK_SIZE=1200
# KNOWLEDGE_CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# Biometric → music tuning (optional; defaults match SystemConfig)
# -----------------------------------------------------------------------------
# MIN_BPM=45
# MAX_BPM=140
# RHYTHM_REDUCTION_PCT=15.0
# AROUSAL_EXTRA_BPM_REDUCTION_MAX=8.0
# HRV_SAFETY_THRESHOLD_MS=40.0
# MAX_NOISE_DB=70.0
# RESPIRATORY_ELEVATED_THRESHOLD=18.0
# (See music_ai_module/config.py for the full list of overrides.)
